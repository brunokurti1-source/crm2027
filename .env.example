# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Used only by prisma/seed.ts in development to create a demo API key
DEMO_API_KEY="crm_demo_local_api_key_change_me"
# Optional: protect POST/GET /api/integrations/tick for interval sync (cron)
INTEGRATION_CRON_SECRET="replace-with-a-long-random-cron-secret"
