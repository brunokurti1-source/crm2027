generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  /// ADMIN | MANAGER | AGENT
  role         String
  active       Boolean  @default(true)
  /// JSON PermissionFlags
  permissions  String   @default("{}")
  managerId    String?
  manager      User?    @relation("ManagerAgents", fields: [managerId], references: [id])
  agents       User[]   @relation("ManagerAgents")
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients  Client[]       @relation("ClientAgent")
  managedClients   Client[]       @relation("ClientManager")
  comments         Comment[]
  meetings         Meeting[]
  reminders        Reminder[]
  tasksAssigned    Task[]         @relation("TaskAssignee")
  tasksCreated     Task[]         @relation("TaskCreator")
  creditEntries    CreditLedger[] @relation("CreditActor")
  notifications    Notification[]
  activityLogs     ActivityLog[]  @relation("ActivityActor")
  auditLogs        AuditLog[]     @relation("AuditActor")
  auditTargets     AuditLog[]     @relation("AuditTarget")
  softDeletes      SoftDelete[]   @relation("SoftDeleteActor")
  drafts           TextDraft[]
}

model TextDraft {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  /// COMMENT | NOTES
  kind      String   @default("COMMENT")
  body      String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, kind])
  @@index([userId, clientId])
}

model Client {
  id               String    @id @default(cuid())
  clientIdNumber   String    @unique
  firstName        String
  lastName         String
  phone            String?
  email            String?
  company          String?
  address          String?
  country          String?
  leadSource       String?
  status           String    @default("NEW")
  creditBalance    Float     @default(0)
  notes            String?
  /// Optimistic concurrency token — incremented on each update
  version          Int       @default(1)
  archived         Boolean   @default(false)
  registrationDate DateTime  @default(now())
  lastContactAt    DateTime?
  agentId          String?
  managerId        String?
  deletedAt        DateTime?
  deletedById      String?
  agent            User?     @relation("ClientAgent", fields: [agentId], references: [id])
  manager          User?     @relation("ClientManager", fields: [managerId], references: [id])
  statusRef        ClientStatus? @relation(fields: [status], references: [code])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comments      Comment[]
  meetings      Meeting[]
  tasks         Task[]
  creditEntries CreditLedger[]
  activityLogs  ActivityLog[]
  drafts        TextDraft[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([country])
  @@index([agentId])
  @@index([managerId])
  @@index([deletedAt])
}

model ClientStatus {
  id        String   @id @default(cuid())
  code      String   @unique
  labelSq   String
  labelEn   String?
  color     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients   Client[]
}

/// Admin-defined fields for CLIENT or USER entities
model CustomFieldDefinition {
  id           String   @id @default(cuid())
  /// CLIENT | USER
  entityType   String
  key          String
  label        String
  /// TEXT | NUMBER | DATE | BOOLEAN | SELECT
  dataType     String   @default("TEXT")
  required     Boolean  @default(false)
  /// JSON string array for SELECT options
  options      String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  showInList   Boolean  @default(false)
  showInFilter Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  values       CustomFieldValue[]

  @@unique([entityType, key])
  @@index([entityType, active, sortOrder])
}

model CustomFieldValue {
  id        String   @id @default(cuid())
  fieldId   String
  entityId  String
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([entityId])
}

model Comment {
  id        String    @id @default(cuid())
  clientId  String
  authorId  String
  body      String
  deletedAt DateTime?
  deletedById String?
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
}

model Meeting {
  id          String   @id @default(cuid())
  clientId    String
  agentId     String
  scheduledAt DateTime
  notes       String?
  /// SCHEDULED | DONE | CANCELLED
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent       User     @relation(fields: [agentId], references: [id])
  reminders   Reminder[]

  @@index([agentId, scheduledAt])
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  title     String
  dueAt     DateTime
  notes     String?
  done      Boolean   @default(false)
  meetingId String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, dueAt])
}

model Task {
  id          String   @id @default(cuid())
  clientId    String?
  assigneeId  String
  createdById String?
  /// CALL | EMAIL | FOLLOW_UP | OTHER
  type        String   @default("FOLLOW_UP")
  title       String
  description String?
  /// LOW | MEDIUM | HIGH
  priority    String   @default("MEDIUM")
  /// OPEN | DONE | POSTPONED | CANCELLED
  status      String   @default("OPEN")
  dueAt       DateTime
  remindAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee    User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, dueAt])
  @@index([status, dueAt])
}

model CreditLedger {
  id              String   @id @default(cuid())
  clientId        String
  actorId         String?
  /// ADD | REMOVE
  direction       String
  amount          Float
  previousBalance Float
  newBalance      Float
  reason          String
  createdAt       DateTime @default(now())
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor           User?    @relation("CreditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

model SoftDelete {
  id           String    @id @default(cuid())
  /// CLIENT | USER | COMMENT
  entityType   String
  entityId     String
  label        String
  payload      String
  deletedById  String?
  deletedAt    DateTime  @default(now())
  restoredAt   DateTime?
  purgedAt     DateTime?
  deletedBy    User?     @relation("SoftDeleteActor", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([entityType, purgedAt])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  /// MEETING | TASK | SYSTEM
  kind      String   @default("SYSTEM")
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  clientId    String?
  actorId     String?
  action      String
  description String
  metadata    String?
  /// When set, action was done while impersonating this user
  viaImpersonationOf String?
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  details      String
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String
  keyPrefix  String
  active     Boolean   @default(true)
  /// When set, API access is limited to this manager's group
  managerId  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([managerId])
}

/// External system connection (admin-managed, optionally scoped to a manager group)
model Integration {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  /// Owning manager group — null = admin/global only
  managerId            String?
  /// Default agent within the manager group for inbound clients
  defaultAgentId       String?
  /// JSON array of agent user IDs allowed to receive data from this integration
  allowedAgentIds      String    @default("[]")
  /// WEBHOOK | REST_POLL | BOTH
  connectionType       String    @default("BOTH")
  /// INBOUND | OUTBOUND | BIDIRECTIONAL
  direction            String    @default("BIDIRECTIONAL")
  baseUrl              String?
  /// API_KEY | BEARER | OAUTH2 | NONE
  authType             String    @default("API_KEY")
  /// AES-GCM encrypted JSON credentials — never logged or returned raw
  credentialsEnc       String?
  /// JSON array: [{ remote, local }]
  fieldMappings        String    @default("[]")
  /// CRM_WINS | REMOTE_WINS | NEWEST_WINS
  conflictPolicy       String    @default("NEWEST_WINS")
  syncIntervalMinutes  Int?
  syncEnabled          Boolean   @default(false)
  active               Boolean   @default(true)
  lastSyncAt           DateTime?
  lastSyncStatus       String?
  lastError            String?
  /// Hashed inbound webhook/API key (X-Integration-Key)
  inboundKeyHash       String?
  inboundKeyPrefix     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  runs                 IntegrationSyncRun[]
  logs                 IntegrationLog[]
  externalIds          IntegrationExternalId[]
  pendingItems         IntegrationPendingItem[]

  @@index([active, syncEnabled])
  @@index([managerId])
}

/// Inbound payloads that could not be assigned to a manager/agent group
model IntegrationPendingItem {
  id            String    @id @default(cuid())
  integrationId String?
  /// Sanitized payload JSON (no secrets)
  payload       String
  externalId    String?
  reason        String
  /// PENDING | ASSIGNED | DISCARDED
  status        String    @default("PENDING")
  assignedClientId String?
  assignedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([integrationId])
}

model IntegrationSyncRun {
  id             String    @id @default(cuid())
  integrationId  String
  /// MANUAL | INTERVAL | WEBHOOK | RETRY | OUTBOUND
  trigger        String    @default("MANUAL")
  /// RUNNING | OK | ERROR | PARTIAL
  status         String    @default("RUNNING")
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  skippedCount   Int       @default(0)
  failedCount    Int       @default(0)
  errorSummary   String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  /// INFO | WARN | ERROR
  level         String   @default("INFO")
  action        String
  message       String
  /// Sanitized metadata JSON (no secrets)
  meta          String?
  createdAt     DateTime @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
}

model IntegrationExternalId {
  id            String   @id @default(cuid())
  integrationId String
  externalId    String
  clientId      String
  lastRemoteAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([clientId])
}
